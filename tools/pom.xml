<?xml version="1.0"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.knative.eventing</groupId>
        <artifactId>connectors</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>connector-tools</artifactId>
    <name>Knative Connectors :: Tools</name>
    <packaging>pom</packaging>

    <modules>
        <module>maven-plugin</module>
    </modules>

    <profiles>
        <!-- The archetype modules use packaging=maven-archetype, which requires the
             archetype-packaging build extension merely to READ their POMs. Maven scans
             every module in the reactor before -pl/-am selects what to build, so these
             modules are always read even though no connector depends on them. In hermetic
             builds the extension is not prefetched, so scanning them fails offline. Gate
             them behind a profile that is active by default but disabled with
             -DskipArchetypes in the hermetic image builds. -->
        <profile>
            <id>archetypes</id>
            <activation>
                <property>
                    <name>!skipArchetypes</name>
                </property>
            </activation>
            <modules>
                <module>archetype-source</module>
                <module>archetype-sink</module>
            </modules>
        </profile>
    </profiles>

</project>
